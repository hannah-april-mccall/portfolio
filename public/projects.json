[
  {
    "id": "caption-extension",
    "title": "Caption creation extension",
    "selected": true,
    "categories": [
      "ai-automations",
      "workflow-tooling"
    ],
    "image": "images/caption-placeholder.png",
    "imageAlt": "Illustrative caption editor with cyan and magenta captions over a mountain scene",
    "imageCaption": "Concept image · AI-generated placeholder",
    "wideImage": false,
    "description": "From transcription to client-ready captions, in over 20 styles.",
    "body": "",
    "metrics": "10,000+ assets · Up to 95% less manual work",
    "technologies": [
      "JavaScript",
      "Adobe CEP",
      "ElevenLabs",
      "n8n"
    ],
    "details": [
      {
        "heading": "The problem",
        "text": "Creative teams needed to produce captions in a growing range of client styles, without repeating the same manual setup for every asset."
      },
      {
        "heading": "What I built",
        "text": "An After Effects extension combining ElevenLabs transcription and n8n workflow proofing, with tools for editing, animating and colouring captions. The extension has supported over 10,000 assets and enabled around 20 times the output capacity."
      },
      {
        "heading": "Making it adaptable",
        "text": "I designed the latest version around centrally stored style information. New client styles, including complex effects and animations, could be introduced without users constantly reinstalling the tool."
      },
      {
        "heading": "Working around a technical limit",
        "text": "After Effects provides the bounding box for a whole text block, rather than the individual line widths needed for caption backers. I devised a recursive binary-search approach to find text boundaries on each frame, supporting individual line measurements and word-by-word animation."
      }
    ],
    "links": []
  },
